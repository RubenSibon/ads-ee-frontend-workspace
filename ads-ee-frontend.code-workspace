{
  "folders": [
    {
      "name": "design-system (core)",
      "path": "design-system"
    },
    {
      "name": "development-standards (core)",
      "path": "development-standards"
    },
    {
      "name": "ee-docs (core)",
      "path": "ee-docs"
    },
    {
      "path": "ee-ads-rhf"
    },
    {
      "path": "ee-react-form-demos"
    },
    {
      "path": "ee-react-map-demos"
    },
    {
      "path": "ee-react-template"
    },
    {
      "path": "design-system-prototypes"
    },
    {
      "path": "amsterdam-agent-skills"
    }
  ],
  "extensions": {
    "recommendations": [
      "github.copilot",
      "github.copilot-chat",
      "dbaeumer.vscode-eslint",
      "stylelint.vscode-stylelint",
      "esbenp.prettier-vscode",
      "github.vscode-pull-request-github"
    ]
  },
  "settings": {
    "css.format.enable": false,
    "css.validate": false,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always",
      "source.fixAll.stylelint": "always"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "eslint.useFlatConfig": true,
    "eslint.workingDirectories": [
      {
        "mode": "auto"
      }
    ],
    "less.validate": false,
    "scss.format.enable": false,
    "scss.validate": false,
    "stylelint.validate": [
      "css",
      "scss"
    ]
  }
}